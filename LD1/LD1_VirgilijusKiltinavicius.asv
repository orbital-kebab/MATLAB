x = 1:32;
y = x.^2;

plot(x,y,'o-r',x,y/3,'xb')
title('Dvi funkcijos')
xlabel('X-ai')
ylabel('F_1 [-o-]  |  F_2 [-x-]')
%% Dokomentacija
help sin
%help displays the help text for the functionality
doc plot
%doc opens the documentation in a new tab in your system web browser
docsearch title
%docsearch opens the documentation home page in a new tab in your system web browser
%% linespace
x1=0;
x2=10;
n=5;
doc linspace
%returns a row vector of evenly spaced points between point interval(x1,x2)
y=linspace(x1,x2);
%by default, generates 100 points
y=linspace(x1,x2,n)
%will generate n points
%if n=1 returns x2
%% size
A=rand(2,3,4,5)
doc size
%size returns a row vector whose elements are the lengths of the
%corresponding dimensions of the matrix
sz=size(A)
%% max
doc max
%returns the maximum elements of an array
A=[2 4 6 8 7]
M=max(A)
%Create a vector and compute its largest element
A = [-2+2i 4+i -1-3i];
max(A)
%Create a complex vector and compute its largest element, that is, the element with the largest magnitude.
A = [2 8 4; 7 3 9]
M = max(A)
%Create a matrix and compute the largest element in each column.
A = [1.7 1.2 1.5; 1.3 1.6 1.99]
M = max(A,[],2)
%Create a matrix and compute the largest element in each row.
%% Papildoma
N=9;
vek = N+1:0.5:N+4
mat = [N N+1 N+2 ;N+3 N+4 N+5; N+6 N+7 N+8]


