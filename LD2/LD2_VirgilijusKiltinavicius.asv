%%Vienmaciai masyvai
clear all
vek = (-pi : 0.7 : 2*pi)';
vek2 = cos(vek);
vekats=vek.^vek2;
vekats = vekats'
%% Dvimaciai masyvai
clear all
xmm = [exp(5) exp(-1i/exp(1)) log(1) ; log(pi) -2 -sin(pi)];
xlm = [xmm(2,1)^2 xmm(1,3) xmm(2,3)^2];
X=[xmm; xlm];
det(X)
%% Praktinis veiksmu su masyvais taikymas
clear all
t = 0:0.005:1;
A=7;
f=4;
o=2;
U1=4.5;
U2=2.5;
n=o*randn(size(t));
s=A*sin(2*pi*f*t)+n;

reiksmesvirs = s(s>U1);

sfilt=s;
sfilt(abs(sfilt)<U2) = 0;

dydis=length(s);

dydis2=length(reiksmesvirs);

didziausia = max(sfilt);
maziausia = min(sfilt);
%% Papildoma
clear all
A = input('Iveskite vektoriu(A):');
B = A(2 : 2 : end);

if mod(length(A),2)==0
    pask_nelyg=length(A)-1;
else
    pask_nelyg=length(A);
end

C=A(pask_n)
